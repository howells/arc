#!/bin/sh

# Auto-bump patch version when plugin files change.
# Skips for site-only changes. Uses env var to prevent infinite loop.
# Bumping is .version-bump.json-driven — see scripts/bump-version.sh.

# Prevent re-entrancy: the amend below triggers post-commit again.
if [ "$ARC_BUMPING_VERSION" = "1" ]; then
  exit 0
fi

# Only bump if plugin-related files changed (not site/, hooks, or version files themselves).
changed_files=$(git diff-tree --no-commit-id --name-only -r HEAD)
plugin_changes=$(echo "$changed_files" \
  | grep -v '^site/' \
  | grep -v '^\.husky/' \
  | grep -v '^\.claude-plugin/plugin\.json$' \
  | grep -v '^\.claude-plugin/marketplace\.json$' \
  | grep -v '^package\.json$' \
  | grep -v '^\.version-bump\.json$' \
  || true)

if [ -z "$plugin_changes" ]; then
  exit 0
fi

# Bump patch across all declared files.
bash scripts/bump-version.sh --bump-patch >/dev/null 2>&1 || exit 0

# Re-stage every declared path and amend.
declared_paths=$(jq -r '.files[].path' .version-bump.json | sort -u)
echo "$declared_paths" | xargs git add
ARC_BUMPING_VERSION=1 git commit --amend --no-edit --no-verify >/dev/null 2>&1
